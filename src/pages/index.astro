---
import { site } from "../config/site";
import * as styles from "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={site.description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#090a0a" />
    <link rel="canonical" href={site.url} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={site.title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content={site.url} />
    <title>{site.title}</title>
  </head>
  <body>
    <main class={styles.main}>
      <section class={styles.splash} data-signature-splash data-layout="left" aria-labelledby="signature-title">
        <h1 id="signature-title" class={styles.heading}>
          <span class={styles.screenReaderText}>The Marc Hermann</span>
          <span class={styles.visualWords} aria-hidden="true">
            <span class={`${styles.word} ${styles.theWord}`}>THE</span>
            <span class={`${styles.word} ${styles.marcWord}`} data-word="MARC" data-texture="soot">MAR<span data-impact="C">C</span></span>
            <span class={`${styles.word} ${styles.hermannWord}`} data-word="HERMANN" data-texture="soot">HE<span data-impact="R">R</span>MANN</span>
          </span>
        </h1>
        <span class={styles.projectile} data-projectile="marc-dash" data-track="baseline" aria-hidden="true"></span>
        <span class={styles.projectile} data-projectile="hermann-dash" data-track="baseline" aria-hidden="true"></span>
        <canvas class={styles.particles} data-particles aria-hidden="true"></canvas>
      </section>
      <p class={styles.cornerMark} aria-hidden="true">M / H — 2026</p>
    </main>
    <script>
      import "../splash/init";
    </script>
    <noscript><style is:global>[data-word]{clip-path:none!important}</style></noscript>
  </body>
</html>
